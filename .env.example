# --- Database (PostgreSQL in production; tests use in-memory SQLite) ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/voice_agent

# --- Voice provider (Edesy) ---
VOICE_API_BASE_URL=https://voice-agent.edesy.in
VOICE_API_KEY=
VOICE_AGENT_ID=
# Optional: caller ID / telephony provider overrides
VOICE_FROM_NUMBER=
VOICE_PROVIDER=
# Public HTTPS base URL of THIS app (used to build the call-ended callback). Leave empty locally;
# the reconciler job then polls the provider instead.
PUBLIC_BASE_URL=
WEBHOOK_SECRET=

# --- Google (Sheets + Gmail) ---
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=Sheet1
# Gmail via service account needs domain-wide delegation; mail is sent as this user
GMAIL_SENDER=

# --- LLM (transcript analysis) ---
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_API_BASE_URL=https://generativelanguage.googleapis.com

# --- App ---
TIMEZONE=Asia/Kolkata
# Comma-separated admin API keys for /api/* (except the voice webhook)
API_KEYS=
LOG_LEVEL=INFO
POLICY_FILE=config/policy.yaml
SYSTEM_PROMPT_FILE=config/system_prompt.md
EMAIL_TEMPLATES_FILE=config/email_templates.yaml

# --- Safety switches (all OFF by default) ---
SCHEDULER_ENABLED=false
ENABLE_REAL_CALLS=false
ENABLE_EMAIL_SENDING=false
# When true, Google Sheets writes are logged instead of performed
SHEETS_DRY_RUN=true

# --- Config files (business details, email templates, sheet columns) ---
BUSINESS_FILE=config/business.yaml
SHEET_COLUMNS_FILE=config/sheet_columns.yaml
