# Copy to .env.docker (git-ignored) and fill in. Used only by compose.yaml.
POSTGRES_USER=voxai_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=voxai
# Must use the same user/password/db as above. Host is the compose service name `postgres`, port is the internal 5432.
DATABASE_URL=postgresql+asyncpg://voxai_app:change-me@postgres:5432/voxai
